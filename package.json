{
  "name": "lash-doc",
  "private": true,
  "packageManager": "pnpm@8.10.0",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "typecheck:product": "tsc -p tsconfig.product.json --noEmit && pnpm --filter @lash/realtime-worker run typecheck",
    "typecheck:harness": "pnpm --filter @lash/web run typecheck:e2e",
    "typecheck": "pnpm run typecheck:product && pnpm run typecheck:harness",
    "build": "pnpm run typecheck:product && pnpm --filter @lash/web build",
    "build:static": "pnpm run typecheck:product && pnpm --filter @lash/web build:static",
    "test": "pnpm run lint && pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "NEXT_PUBLIC_LASH_TEST_HOOKS=true pnpm --filter @lash/web build && playwright test",
    "test:e2e:ci": "NEXT_PUBLIC_LASH_TEST_HOOKS=true pnpm --filter @lash/web build:ci && playwright test --workers=1",
    "verify:realtime": "node scripts/verify-realtime-runtime.mjs",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build:ci": "pnpm run typecheck:product && pnpm --filter @lash/web build:ci",
    "build:static:ci": "pnpm run typecheck:product && pnpm --filter @lash/web build:static:ci"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-markdown>markdown-it": "14.3.3",
      "prosemirror-model": "1.25.8",
      "prosemirror-view": "1.42.3",
      "postcss>source-map-js": "1.2.2"
    }
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "^1.55.1",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-node": "0.3.9",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1",
    "wrangler": "^4.97.0"
  }
}
