{
  "name": "@lash/realtime-worker",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev --config wrangler.jsonc --local --port 8787",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run",
    "types": "wrangler types --config wrangler.jsonc src/worker-configuration.d.ts && node ../../scripts/strip-trailing-whitespace.mjs src/worker-configuration.d.ts"
  },
  "dependencies": {
    "yjs": "^13.6.31"
  }
}
