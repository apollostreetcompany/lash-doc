{
  "name": "@lash/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "python3 ../../tools/disk_admission.py check --output-root .next && next dev --webpack",
    "build": "python3 ../../tools/disk_admission.py check --output-root .next && pnpm run build:ci",
    "build:static": "python3 ../../tools/disk_admission.py check --output-root .next && python3 ../../tools/disk_admission.py check --output-root out && pnpm run build:static:ci",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "build:ci": "next build --webpack",
    "build:static:ci": "LASH_STATIC_EXPORT=1 next build --webpack"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@tiptap/core": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "y-prosemirror": "^1.2.5",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.110.0"
  }
}
