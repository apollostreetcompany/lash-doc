{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@lash/editor-core": ["packages/editor-core/src"],
      "@lash/ui": ["packages/ui/src"],
      "@lash/types": ["packages/types/src"],
      "@lash/testing/*": ["packages/testing/*"],
      "@lash/collab-service": ["packages/collab-service/src"],
      "@lash/history": ["packages/history/src"],
      "@lash/authorship": ["packages/authorship/src"],
      "@lash/mentions": ["packages/mentions/src"],
      "@lash/share": ["packages/share/src"],
      "@lash/ai": ["packages/ai/src"],
      "@lash/doc-chat": ["packages/doc-chat/src"],
      "@lash/tables-media": ["packages/tables-media/src"],
      "@lash/observability": ["packages/observability/src"],
      "@lash/storage": ["packages/storage/src"],
      "@lash/infra-scripts": ["packages/infra-scripts/src"],
      "@lash/realtime-worker": ["packages/realtime-worker/src"],
      "@lash/rbac": ["packages/rbac/src"]
    }
  },
  "include": [],
  "exclude": ["node_modules", "dist", ".next"]
}
