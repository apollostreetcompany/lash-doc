{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "apps/web/next-env.d.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "apps/web/e2e",
    "apps/web/.next",
    "apps/web/node_modules",
    "packages/testing",
    "packages/realtime-worker",
    "packages/*/dist",
    "node_modules"
  ]
}
